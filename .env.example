# QRo Environment Configuration Template
# To activate production Google Analytics 4 tracking:
# 1. Copy this file to `.env` or `.env.local`
# 2. Replace the placeholder below with your GA4 Measurement ID (Format: G-XXXXXXXXXX)
# 3. Rebuild the application with `npm run build`

REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Set to true if you want to inspect GA4 debug logs in production
# REACT_APP_ANALYTICS_DEBUG=false
